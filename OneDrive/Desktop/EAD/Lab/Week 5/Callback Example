<!DOCTYPE html>
<html>
<head>
    <title>Callback Example</title>
</head>

<body>

    <div style="position:absolute; top:10px; right:20px; text-align:right;">
        <h4>Name: Damodara Lakshmi Madhulika</h4>
        <h4>Roll No: 160124737144</h4>
        <p><b>Open Console</b></p>
    </div>

    <script>
        // Function with callback
        function greet(name, callback) {
            console.log("Hi " + name);
            callback();   // calling the callback function
        }

        // Callback function
        function sayBye() {
            console.log("Bye");
        }

        // Passing function as argument
        greet("Madhu", sayBye);
    </script>

</body>
</html>