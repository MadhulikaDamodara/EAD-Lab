<!DOCTYPE html>
<html>
<head>
    <title>Async Await Example</title>
</head>

<body>

    <div style="position:absolute; top:10px; right:20px; text-align:right;">
        <h4>Name: Damodara Lakshmi Madhulika</h4>
        <h4>Roll No: 160124737144</h4>
        <p><b>Open Console</b></p>
    </div>

    <script>
        // Function returning a Promise
        function fetchData() {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    resolve("Data Loaded!");
                }, 2000);
            });
        }

        // Async function
        async function displayData() {
            console.log("Loading...");

            let result = await fetchData();  // waits until promise resolves

            console.log(result);
        }

        // Calling function
        displayData();
    </script>

</body>
</html>